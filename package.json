{
  "name": "est-aws",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "backend",
  "blocksTemplateDescription": "Backend-only — Blocks API + CDK, no frontend (bring your own client)",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "aws-blocks"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "spec": "blocks-generate-spec",
    "dev": "tsx watch aws-blocks/scripts/server.ts",
    "sandbox": "tsx aws-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx -C cdk aws-blocks/scripts/sandbox-destroy.ts",
    "sandbox:console": "tsx aws-blocks/scripts/console.ts",
    "cleanup": "tsx aws-blocks/scripts/cleanup.ts",
    "migrate": "tsx aws-blocks/scripts/migrate.ts",
    "lint:migrations": "tsx aws-blocks/scripts/lint-migrations.ts",
    "infra-diff": "tsx -C cdk aws-blocks/scripts/infra-diff-gate.ts",
    "infra-diff:update-baseline": "tsx -C cdk aws-blocks/scripts/infra-diff-gate.ts --update-baseline",
    "deploy": "tsx aws-blocks/scripts/deploy.ts",
    "destroy": "tsx aws-blocks/scripts/destroy.ts",
    "vendorize": "blocks-vendorize",
    "build": "npm run typecheck",
    "test": "npm run typecheck && vitest run"
  },
  "dependencies": {
    "@aws-blocks/blocks": "*",
    "@aws-blocks/data-common": "^0.1.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/node": "^20.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "aws-cdk-lib": "2.257.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.27.1",
    "openapi-types": "^12.1.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "blocksTemplateVersion": "0.1.0"
}
